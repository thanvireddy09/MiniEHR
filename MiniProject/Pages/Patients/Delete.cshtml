@page
@model MiniProject.Pages.Patients.DeleteModel

<h2>Delete Patient</h2>

@if (ViewData.ModelState.TryGetValue(string.Empty, out var errors) && errors.Errors.Count > 0)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in errors.Errors)
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<h3>Are you sure you want to delete this patient?</h3>

<div>
    <h4>Patient</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Patient.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Patient.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Patient.DateOfBirth)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Patient.DateOfBirth)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Patient.Gender)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Patient.Gender)</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Patient.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
