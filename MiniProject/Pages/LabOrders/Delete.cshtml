@page "{id:int}"
@model MiniProject.Pages.LabOrders.DeleteModel

<h2>Delete Lab Order</h2>

<div class="row">
    <div class="col-md-6">
        <h4>Are you sure you want to delete this lab order?</h4>

        <div>
            <dl class="row">
                <dt class="col-sm-3">Test Name</dt>
                <dd class="col-sm-9">@Model.LabOrder.TestName</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.LabOrder.Status</dd>
            </dl>
        </div>

        <form method="post">
            <input type="hidden" asp-for="LabOrder.Id" />
            <div class="form-group">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="./Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
